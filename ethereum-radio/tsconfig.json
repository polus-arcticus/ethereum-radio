{
	"compilerOptions": {
		"lib": ["es2023", "dom"],
		"module": "node16",
		"target": "es2022",
		"moduleResolution": "node16",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"rootDir": "src",
		"jsx": "react-jsx",
		"types": ["node"]
	},
	"include": ["src"]
}
