{
	"name": "@ethereum-radio/indexer",
	"version": "0.0.3",
	"description": "Browser-side event-log indexing for dapps — a resumable, incremental eth_getLogs cursor with viem/ethers adapters, pluggable storage, and IPFS export/import.",
	"keywords": [
		"ethereum",
		"evm",
		"web3",
		"dapp",
		"indexer",
		"indexing",
		"event-logs",
		"eth_getLogs",
		"viem",
		"ethers",
		"browser"
	],
	"homepage": "https://polus-arcticus.github.io/ethereum-radio/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/polus-arcticus/ethereum-radio.git",
		"directory": "ethereum-radio"
	},
	"bugs": {
		"url": "https://github.com/polus-arcticus/ethereum-radio/issues"
	},
	"license": "Unlicense",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./core/*": {
			"types": "./dist/core/*.d.ts",
			"default": "./dist/core/*.js"
		},
		"./adapters/*": {
			"types": "./dist/adapters/*.d.ts",
			"default": "./dist/adapters/*.js"
		},
		"./storage/*": {
			"types": "./dist/storage/*.d.ts",
			"default": "./dist/storage/*.js"
		},
		"./sync/*": {
			"types": "./dist/sync/*.d.ts",
			"default": "./dist/sync/*.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./src/*": "./src/*"
	},
	"files": [
		"dist",
		"src"
	],
	"peerDependencies": {
		"@helia/json": ">=6",
		"ethers": ">=6",
		"helia": ">=7",
		"react": ">=18",
		"viem": ">=2"
	},
	"peerDependenciesMeta": {
		"@helia/json": {
			"optional": true
		},
		"ethers": {
			"optional": true
		},
		"helia": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"viem": {
			"optional": true
		}
	},
	"devDependencies": {
		"@helia/json": "^6.0.5",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.14",
		"earl": "^2.0.0",
		"ethers": "^6.13.0",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^15.11.7",
		"helia": "^7.1.10",
		"multiformats": "^14.0.5",
		"prettier": "^3.9.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "~6.0.3",
		"viem": "^2.55.19"
	},
	"scripts": {
		"compile": "tsc",
		"compile:watch": "as-soon -w src pnpm compile",
		"build": "pnpm compile",
		"test": "bash scripts/test-with-anvil.sh",
		"test:only": "node --experimental-strip-types --test --test-concurrency=1 \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
		"test:mainnet": "node --env-file=../contracts/.env --experimental-strip-types --test \"test/mainnet/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	}
}
